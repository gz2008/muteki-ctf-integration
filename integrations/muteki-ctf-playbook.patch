diff --git a/muteki/solver/ctf_taxonomy.py b/muteki/solver/ctf_taxonomy.py
new file mode 100644
index 0000000..ededc96
--- /dev/null
+++ b/muteki/solver/ctf_taxonomy.py
@@ -0,0 +1,132 @@
+"""Category action priors from the repository taxonomy.
+
+``skills/muteki-worldmodel/taxonomy`` shipped six category files that nothing
+referenced. This module turns one of them into a compact prior block that a CTF
+Worker receives with the playbook, so the action vocabulary, risk classes and
+completion state are visible where the work happens instead of staying inert
+JSON.
+
+The loader never raises: a missing or malformed file yields an empty prior,
+because a methodology hint must not be able to fail a run.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any, Optional
+
+_TAXONOMY_ROOT = (
+    Path(__file__).resolve().parents[2]
+    / "skills" / "muteki-worldmodel" / "taxonomy"
+)
+
+# The challenge category is spelled ``reverse`` while the taxonomy file is
+# ``rev.json``; keep the mapping explicit instead of guessing by prefix.
+_CATEGORY_FILES: dict[str, str] = {
+    "web": "web",
+    "pwn": "pwn",
+    "reverse": "rev",
+    "crypto": "crypto",
+    "forensics": "forensics",
+    "misc": "misc",
+}
+
+_RISK_ORDER = {"safe": 0, "probe": 1, "exploit": 2}
+
+
+def taxonomy_path(category: str) -> Optional[Path]:
+    """Path of the taxonomy file for one challenge category, if it exists."""
+    name = _CATEGORY_FILES.get(str(category or "").strip().lower())
+    if not name:
+        return None
+    path = _TAXONOMY_ROOT / f"{name}.json"
+    return path if path.is_file() else None
+
+
+def load_category(category: str) -> Optional[dict[str, Any]]:
+    """Parsed taxonomy for one category, or ``None`` when unavailable."""
+    path = taxonomy_path(category)
+    if path is None:
+        return None
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError):
+        return None
+    if not isinstance(data, dict) or not data.get("domain"):
+        return None
+    return data
+
+
+def _sorted_actions(data: dict[str, Any]) -> list[dict[str, Any]]:
+    actions = [item for item in data.get("actions", []) if isinstance(item, dict)]
+    return sorted(
+        actions,
+        key=lambda item: (
+            _RISK_ORDER.get(str(item.get("risk_class", "")), 9),
+            int(item.get("cost_estimate_units") or 0),
+            str(item.get("name", "")),
+        ),
+    )
+
+
+def category_prior(category: str) -> str:
+    """Compact agent-facing prior block, or an empty string when unavailable."""
+    data = load_category(category)
+    if data is None:
+        return ""
+    lines = [
+        "## Category action prior",
+        "",
+        f"- category: `{data.get('domain')}`"
+        f"  completion state: `{data.get('completion_state', '')}`",
+    ]
+    entities = ", ".join(str(item) for item in data.get("entity_kinds", []))
+    if entities:
+        lines.append(f"- entity kinds: {entities}")
+    states = ", ".join(f"`{item}`" for item in data.get("state_variables", []))
+    if states:
+        lines.append(f"- track state: {states}")
+    actions = _sorted_actions(data)
+    if actions:
+        cheap = [
+            f"`{item.get('name')}` ({item.get('risk_class')}, "
+            f"{item.get('cost_estimate_units')}u)"
+            for item in actions if str(item.get("risk_class")) != "exploit"
+        ]
+        costly = [
+            f"`{item.get('name')}` ({item.get('risk_class')}, "
+            f"{item.get('cost_estimate_units')}u)"
+            for item in actions if str(item.get("risk_class")) == "exploit"
+        ]
+        if cheap:
+            lines.append("- cheapest falsifiable moves first: " + ", ".join(cheap))
+        if costly:
+            lines.append("- escalate only with evidence: " + ", ".join(costly))
+    reachability = data.get("initial_reachability")
+    if isinstance(reachability, (int, float)) and reachability > 0:
+        lines.append(
+            "- treat the target as unreachable until a real response proves "
+            "otherwise; the taxonomy expects "
+            f"{reachability:g} initial reachability"
+        )
+    lines.append(
+        "- this prior is vocabulary and ordering, not evidence: a Fact still "
+        "needs real tool output."
+    )
+    return "\n".join(lines) + "\n"
+
+
+def available_categories() -> tuple[str, ...]:
+    """Categories that currently have a usable taxonomy file."""
+    return tuple(
+        category for category in _CATEGORY_FILES if taxonomy_path(category)
+    )
+
+
+__all__ = [
+    "available_categories",
+    "category_prior",
+    "load_category",
+    "taxonomy_path",
+]
