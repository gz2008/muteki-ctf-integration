+def stage_ctf_playbook_skill(
+    workdir: str | Path,
+    *,
+    engine: str,
+    container: object | None = None,
+    mode: str = "ctf",
+    category: str = "",
+) -> list[str]:
+    """Expose the category-routed CTF playbook to CTF Workers.
+
+    The playbook is a reference Skill, not a prompt: a Worker opens ``SKILL.md``
+    and at most one ``references/<category>.md`` when it needs method, so the
+    per-Step prompt keeps its size. Penetration-testing Workers keep their own
+    guidance and are deliberately skipped.
+
+    It is an optional capability: a disabled setting, a missing source, or a
+    non-CTF mode returns an empty list instead of failing Worker preparation.
+    Operator-supplied content at a projected path is preserved.
+
+    ``category`` additionally materialises the category action prior from
+    ``skills/muteki-worldmodel/taxonomy`` as ``references/category-prior.md``,
+    which is the only consumer of that repository data.
+    """
+    if str(mode or "ctf") != "ctf":
+        return []
+
+    from muteki.capability_management import enabled as capability_enabled
+
+    if not capability_enabled("skills", CTF_PLAYBOOK_SKILL_NAME):
+        return []
+    source = _REPO_CTF_PLAYBOOK_SKILL
+    if not (source / "SKILL.md").is_file():
+        return []
+
+    root = Path(workdir).resolve()
+    target = root / ".muteki-skills" / CTF_PLAYBOOK_SKILL_NAME
+    target.mkdir(parents=True, exist_ok=True)
+    shutil.copyfile(source / "SKILL.md", target / "SKILL.md")
+    references = source / "references"
+    if references.is_dir():
+        shutil.copytree(references, target / "references", dirs_exist_ok=True)
+    prior = _category_prior_text(category)
+    if prior:
+        (target / "references").mkdir(parents=True, exist_ok=True)
+        (target / "references" / "category-prior.md").write_text(
+            prior, encoding="utf-8"
+        )
+    tool_index = tool_index_text(category=category, container=container)
+    if tool_index:
+        (target / "references").mkdir(parents=True, exist_ok=True)
+        (target / "references" / "tool-index.md").write_text(
+            tool_index, encoding="utf-8"
+        )
+    if container is not None:
+        from muteki.solver.container_exec import _chown_tree_to_worker
+        _chown_tree_to_worker(str(target), image=container.image)
+
+    staged: list[str] = []
+    for relative in project_skill_roots(engine):
+        destination = root / relative / CTF_PLAYBOOK_SKILL_NAME
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        link = os.path.relpath(target, start=destination.parent)
+        try:
+            if destination.is_symlink():
+                if os.readlink(destination) == link:
+                    staged.append(str(destination))
+                    continue
+                destination.unlink()
+            elif destination.exists():
+                # An operator-provided Skill with this name wins; the playbook
+                # never overwrites Worker project content.
+                staged.append(str(destination))
+                continue
+            destination.symlink_to(link, target_is_directory=True)
+        except OSError:
+            # Filesystems without symlink support get a private physical copy.
+            # The container path is not readable on the host, so that case must
+            # fail loudly instead of copying an unrelated source.
+            if container is not None:
+                raise
+            shutil.copytree(target, destination)
+        staged.append(str(destination))
+    return staged
+
+
+def _category_prior_text(category: str) -> str:
+    """Category prior rendered from the repository taxonomy; empty when absent."""
+    from muteki.solver.ctf_taxonomy import category_prior
+
+    try:
+        return category_prior(category)
+    except (OSError, ValueError):
+        return ""
+
+
+def _local_tool_root() -> Path:
+    """Tool root a local Worker receives as ./toolbox, mirroring workspace.py."""
+    repo_root = Path(__file__).resolve().parents[2]
+    return Path(
+        os.environ.get("MUTEKI_LOCAL_WORKER_ROOT")
+        or os.environ.get("MUTEKI_MAC_WORKER_ROOT")
+        or repo_root / "ctf-tools"
+    ).resolve()
+
+
+def tool_index_text(
+    *, category: str = "", container: object | None = None,
+) -> str:
+    """Inventory of what this Worker can actually call, or an empty string.
+
+    The playbook names tools in prose; a Worker otherwise discovers which of
+    them exist by trial and error. Local Workers get the real listing of their
+    projected tool root. Container Workers get the corpus layout plus the hint
+    to enumerate `./toolbox/bin` themselves, because probing the image here
+    would duplicate the workspace probe.
+    """
+    lines: list[str] = ["## Tool index", ""]
+    if container is None:
+        root = _local_tool_root()
+        bin_dir = root / "bin"
+        names: list[str] = []
+        if bin_dir.is_dir():
+            names = sorted(
+                item.name for item in bin_dir.iterdir() if item.is_file()
+            )
+        if names:
+            lines.append(
+                f"- `./toolbox/bin` exposes {len(names)} commands: "
+                + ", ".join(f"`{name}`" for name in names)
+            )
+        else:
+            lines.append(
+                "- `./toolbox/bin` is unavailable in this run; verify a command "
+                "with `command -v <name>` before relying on it."
+            )
+        corpora: list[str] = []
+        for logical, relative in (
+            ("knowledge", "knowledges"),
+            ("pocs", "pocs"),
+            ("wordlists", "wordlists"),
+            ("nuclei-templates", "nuclei-templates"),
+        ):
+            path = root / relative
+            if path.is_dir() and any(path.iterdir()):
+                corpora.append(f"`./toolbox/{logical}`")
+        if corpora:
+            lines.append(
+                "- offline corpora: " + ", ".join(corpora)
+                + "; search them with `./toolbox/bin/ctf-corpus <regex>` "
+                "(regex) or `./toolbox/bin/ctf-index \"<question>\"` (ranked "
+                "passages) instead of reading whole trees."
+            )
+        if "ctf-xor" in names:
+            lines.append(
+                "- obfuscated payloads: `./toolbox/bin/ctf-xor <file>` derives a "
+                "repeating XOR pad from known or expected plaintext and only "
+                "accepts it when a PNG/zlib/ZIP checksum verifies it."
+            )
+        if "tesseract" in names:
+            lines.append(
+                "- text carried inside an image (a flag rendered into a "
+                "screenshot, a captcha, a scanned page): upscale first "
+                "(`magick in.png -resize 400% -colorspace Gray -threshold 50% "
+                "big.png`) then `./toolbox/bin/tesseract big.png -`; small text "
+                "reads as garbage."
+            )
+        if "ctf-triage" in names:
+            lines.append(
+                "- start every Step with `./toolbox/bin/ctf-triage .`: one pass "
+                "for types, entropy, embedded objects, archive contents and "
+                "protections, plus the next command worth running. "
+                "For captures use `./toolbox/bin/ctf-net CAP --out carved/`, "
+                "which reassembles streams in sequence order, finds the record "
+                "framing, derives a repeating pad from forced plaintext, and "
+                "validates what it carves."
+            )
+        glibc_libs = Path("/opt/ctf/third-party/glibc-all-in-one/libs")
+        if glibc_libs.is_dir():
+            versions = sorted(
+                item.name for item in glibc_libs.iterdir() if item.is_dir()
+            )
+            if versions:
+                lines.append(
+                    "- offline glibc builds for local reproduction: "
+                    + ", ".join(versions)
+                )
+    else:
+        lines.append(
+            "- enumerate the projected tool root yourself: "
+            "`ls ./toolbox/bin` and `command -v <name>`; slim images carry fewer "
+            "entries than the Kali full image."
+        )
+        lines.append(
+            "- offline corpora live under `./toolbox/knowledge|pocs|wordlists|"
+            "nuclei-templates` when the host projected them."
+        )
+    lines.append("")
+    lines.append(
+        "Check `command -v` before a long command; the index reflects the run, "
+        "not a promise."
+    )
+    return "\n".join(lines) + "\n"
+
+
